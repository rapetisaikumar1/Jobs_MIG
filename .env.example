# MaverickInnogarage: required environment variables. Copy to .env (never commit .env).

# Public site URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Project Settings → Database). App runtime uses the pooler (port 6543);
# connection_limit=1 on Vercel, 5 on a long-running server.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432), used by Prisma migrations.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Protects the upload cleanup cron job. Use a long random string.
CRON_SECRET=generate-a-long-random-string

# Optional: "Continue with Google" returns to this site, so Google's screens show your domain
# instead of <project>.supabase.co. Use the same OAuth client as the Supabase Google provider and add
# <site>/auth/google/callback to its Authorized redirect URIs first.
GOOGLE_SIGNIN_ON_SITE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
