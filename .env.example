# ---------------------------------------------------------------------------
# MaverickInnogarage — environment configuration. Copy to .env (never commit .env).
# ---------------------------------------------------------------------------

# Public site URL (used in auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DOCUMENTS_BUCKET=candidate-documents

# Database (Project Settings → Database → Connection string)
# Pooled connection (Supavisor/PgBouncer, TRANSACTION mode, port 6543) used by the app at runtime.
#  - pgbouncer=true       required in transaction mode (disables Prisma prepared statements).
#  - connection_limit=N   Prisma pool size PER app instance. Serverless (Vercel): 1.
#                         Long-lived Node instances: 5 is enough (CPU saturates first, ~50 req/s per
#                         instance in load tests). Keep instances x N well under the pooler's
#                         client limit, and the pooler's server pool well under Postgres
#                         max_connections (default 100 on Supabase small plans).
#  - pool_timeout=10      seconds a request waits for a pooled connection before failing.
# Never point DATABASE_URL straight at port 5432 with several instances; that exhausted
# max_connections in load tests.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / session connection (port 5432) used by Prisma migrations:
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Protects /api/cron/cleanup-uploads (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=generate-a-long-random-string

# Maximum session age before re-login is required (hours).
STAFF_SESSION_MAX_HOURS=12
CANDIDATE_SESSION_MAX_HOURS=168

# Public contact details shown in the footer and privacy notice.
NEXT_PUBLIC_CONTACT_EMAIL=careers@maverickinnogarage.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@maverickinnogarage.com
NEXT_PUBLIC_CONTACT_PHONE=+1 (416) 555-0100
NEXT_PUBLIC_CONTACT_ADDRESS=Toronto, Ontario, Canada

# Demo seed only (npm run db:seed). Password for all demo logins; leave unset in production.
SEED_DEMO_PASSWORD=
SEED_EMAIL_DOMAIN=example.com
