// MaverickInnogarage — application schema (Supabase PostgreSQL).
//
// Conventions
// - Internal primary keys are UUIDs. Human-readable display IDs (MIG-JOB-000001, ...)
//   are generated by the database from sequences (see the init migration), so concurrent
//   inserts can never produce duplicates.
// - Identity, passwords and sessions live in Supabase Auth (auth.users). `users.id`
//   equals the Supabase Auth user id.
// - Timestamps are stored as timestamptz (UTC).
// - Files live in Supabase Storage; `documents` only stores references and metadata.

generator client {
  provider = "prisma-client-js"
  // Nested include/select trees load as one joined query instead of one query per relation level
  // (the database is a network round trip away, so this removes most per-page waiting).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserType {
  STAFF
  CANDIDATE
}

enum Country {
  US
  CA
  OTHER
}

enum Currency {
  USD
  CAD
}

enum CompensationType {
  ANNUAL
  HOURLY
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  PART_TIME
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum Source {
  JOB_PORTAL
  INTERNAL_RECRUITMENT
  REFERRAL
  OTHER
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  SUBMITTED_TO_CLIENT
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum Qualification {
  HIGH_SCHOOL
  DIPLOMA
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

enum WorkAuthorizationStatus {
  CITIZEN
  PERMANENT_RESIDENT
  WORK_PERMIT
  REQUIRES_SPONSORSHIP
  OTHER
}

enum CandidateSkillLevel {
  PRIMARY
  SECONDARY
}

enum JobSkillType {
  REQUIRED
  PREFERRED
}

enum DocumentType {
  RESUME
  COVER_LETTER
  SUPPORTING
}

enum DocumentStatus {
  PENDING
  ACTIVE
}

// ---------------------------------------------------------------------------
// Users, roles, permissions
// ---------------------------------------------------------------------------

model User {
  id        String   @id @db.Uuid // = auth.users.id
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  type      UserType
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles            UserRole[]
  candidateProfile CandidateProfile? @relation("CandidateAccount")

  createdJobs          Job[]                      @relation("JobCreatedBy")
  assignedJobs         Job[]                      @relation("JobRecruiter")
  ownedCandidates      CandidateProfile[]         @relation("CandidateOwner")
  createdCandidates    CandidateProfile[]         @relation("CandidateCreatedBy")
  assignedApplications Application[]              @relation("ApplicationRecruiter")
  consentRecords       Application[]              @relation("ApplicationConsentRecordedBy")
  statusChanges        ApplicationStatusHistory[]
  applicationNotes     ApplicationNote[]
  uploadedDocuments    Document[]

  @@index([type, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  // Stable key for built-in roles (SUPER_ADMIN, ADMIN, RECRUITER, CANDIDATE); null for custom roles.
  key         String?  @unique
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model Job {
  id                  String           @id @default(uuid()) @db.Uuid
  displayId           String           @unique @default(dbgenerated("mig_next_display_id('MIG-JOB-'::text, 'job_display_seq'::regclass)")) @map("display_id")
  title               String
  description         String
  responsibilities    String?
  minExperience       Int?             @map("min_experience")
  maxExperience       Int?             @map("max_experience")
  education           String?
  country             Country
  state               String
  city                String
  workArrangement     WorkArrangement  @map("work_arrangement")
  employmentType      EmploymentType   @map("employment_type")
  compensationMin     Decimal?         @map("compensation_min") @db.Decimal(12, 2)
  compensationMax     Decimal?         @map("compensation_max") @db.Decimal(12, 2)
  currency            Currency         @default(USD)
  compensationType    CompensationType @default(ANNUAL) @map("compensation_type")
  salaryPublic        Boolean          @default(false) @map("salary_public")
  applicationDeadline DateTime?        @map("application_deadline") @db.Date
  isFeatured          Boolean          @default(false) @map("is_featured")
  status              JobStatus        @default(DRAFT)
  assignedRecruiterId String?          @map("assigned_recruiter_id") @db.Uuid
  internalNotes       String?          @map("internal_notes")
  createdById         String           @map("created_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  // First publication date. Set once; never reset by edits or re-opening.
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(3)
  closedAt            DateTime?        @map("closed_at") @db.Timestamptz(3)

  assignedRecruiter User?         @relation("JobRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  createdBy         User          @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  skills            JobSkill[]
  caseFile          CaseFile?
  applications      Application[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([assignedRecruiterId])
  @@index([country, state])
  @@index([workArrangement])
  @@index([employmentType])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_title_trgm_idx")
  @@index([createdById]) // job scope: "created by me OR assigned to me"
  @@index([createdAt(sort: Desc)]) // admin jobs list order
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_display_id_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_city_trgm_idx")
  @@map("jobs")
}

model Skill {
  id   String @id @default(uuid()) @db.Uuid
  name String
  // Lower-cased, whitespace-normalized name used for matching ("spring boot").
  slug String @unique

  jobs       JobSkill[]
  candidates CandidateSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String       @map("job_id") @db.Uuid
  skillId String       @map("skill_id") @db.Uuid
  type    JobSkillType

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

// ---------------------------------------------------------------------------
// Candidates
// ---------------------------------------------------------------------------

model CandidateProfile {
  id        String  @id @default(uuid()) @db.Uuid
  displayId String  @unique @default(dbgenerated("mig_next_display_id('MIG-CAN-'::text, 'candidate_display_seq'::regclass)")) @map("display_id")
  // Linked portal account. Null for internal candidates without a portal login.
  userId    String? @unique @map("user_id") @db.Uuid
  source    Source  @default(JOB_PORTAL)

  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  // Stored lower-cased. Email is the primary duplicate-matching signal.
  email          String  @unique
  phone          String?
  alternatePhone String? @map("alternate_phone")
  country        Country
  state          String?
  city           String?
  postalCode     String? @map("postal_code")
  linkedinUrl    String? @map("linkedin_url")

  professionalTitle         String?                  @map("professional_title")
  currentTitle              String?                  @map("current_title")
  currentEmployer           String?                  @map("current_employer")
  totalExperienceYears      Float?                   @map("total_experience_years")
  relevantExperienceYears   Float?                   @map("relevant_experience_years")
  highestQualification      Qualification?           @map("highest_qualification")
  education                 String?
  certifications            String[]                 @default([])
  preferredJobTitles        String[]                 @default([]) @map("preferred_job_titles")
  preferredLocations        String[]                 @default([]) @map("preferred_locations")
  preferredWorkArrangements WorkArrangement[]        @default([]) @map("preferred_work_arrangements")
  preferredEmploymentTypes  EmploymentType[]         @default([]) @map("preferred_employment_types")
  expectedCompensation      Decimal?                 @map("expected_compensation") @db.Decimal(12, 2)
  compensationType          CompensationType?        @map("compensation_type")
  currency                  Currency?
  noticePeriodDays          Int?                     @map("notice_period_days")
  availableFrom             DateTime?                @map("available_from") @db.Date
  workAuthCountry           Country?                 @map("work_auth_country")
  workAuthStatus            WorkAuthorizationStatus? @map("work_auth_status")

  // Staff-only fields — never rendered on the candidate portal.
  profileOwnerId String? @map("profile_owner_id") @db.Uuid
  internalNotes  String? @map("internal_notes")
  createdById    String? @map("created_by_id") @db.Uuid

  defaultResumeId String? @unique @map("default_resume_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Maintained by the application (see modules/candidates/search-vector.ts).
  searchVector Unsupported("tsvector")? @map("search_vector")

  user          User?            @relation("CandidateAccount", fields: [userId], references: [id], onDelete: SetNull)
  profileOwner  User?            @relation("CandidateOwner", fields: [profileOwnerId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  defaultResume Document?        @relation("DefaultResume", fields: [defaultResumeId], references: [id], onDelete: SetNull)
  skills        CandidateSkill[]
  documents     Document[]       @relation("CandidateDocuments")
  applications  Application[]

  @@index([country, state, city])
  @@index([source])
  @@index([totalExperienceYears])
  @@index([phone])
  @@index([updatedAt(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_last_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_email_trgm_idx")
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_display_id_trgm_idx")
  @@index([createdAt(sort: Desc)]) // search sort: newest
  @@index([lastName, firstName]) // search sort: name
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_phone_trgm_idx")
  @@index([alternatePhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_alternate_phone_trgm_idx")
  @@index([currentTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_current_title_trgm_idx")
  @@index([professionalTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidate_profiles_professional_title_trgm_idx")
  @@map("candidate_profiles")
}

model CandidateSkill {
  candidateId String              @map("candidate_id") @db.Uuid
  skillId     String              @map("skill_id") @db.Uuid
  level       CandidateSkillLevel

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([candidateId, skillId])
  @@index([skillId, level])
  @@map("candidate_skills")
}

// ---------------------------------------------------------------------------
// Applications and case files
// ---------------------------------------------------------------------------

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  displayId   String            @unique @default(dbgenerated("mig_next_display_id('MIG-APP-'::text, 'application_display_seq'::regclass)")) @map("display_id")
  candidateId String            @map("candidate_id") @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  status      ApplicationStatus @default(APPLIED)
  source      Source
  appliedAt   DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)

  relevantExperienceYears   Float?  @map("relevant_experience_years")
  relevantExperienceSummary String? @map("relevant_experience_summary")
  availability              String?
  workAuthorizationResponse String? @map("work_authorization_response")
  additionalComments        String? @map("additional_comments")

  assignedRecruiterId String? @map("assigned_recruiter_id") @db.Uuid

  // For candidates added by recruiters: basis on which MIG represents the candidate.
  consentBasis        String?   @map("consent_basis")
  consentRecordedAt   DateTime? @map("consent_recorded_at") @db.Timestamptz(3)
  consentRecordedById String?   @map("consent_recorded_by_id") @db.Uuid

  // Point-in-time copy of the candidate profile submitted with this application.
  candidateSnapshot Json @map("candidate_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidate         CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job               Job                        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignedRecruiter User?                      @relation("ApplicationRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  consentRecordedBy User?                      @relation("ApplicationConsentRecordedBy", fields: [consentRecordedById], references: [id], onDelete: SetNull)
  folder            CaseFolder?
  documents         Document[]
  statusHistory     ApplicationStatusHistory[]
  notes             ApplicationNote[]

  // A candidate can never hold two application records for the same job.
  @@unique([candidateId, jobId])
  @@index([jobId, status])
  @@index([status, appliedAt(sort: Desc)])
  @@index([appliedAt(sort: Desc)])
  @@index([assignedRecruiterId])
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "applications_display_id_trgm_idx")
  @@index([jobId, appliedAt(sort: Desc)]) // a job's applications, newest first
  @@index([assignedRecruiterId, appliedAt(sort: Desc)]) // "assigned to me", newest first
  @@index([source, appliedAt(sort: Desc)]) // source filter
  @@map("applications")
}

model CaseFile {
  id        String   @id @default(uuid()) @db.Uuid
  displayId String   @unique @default(dbgenerated("mig_next_display_id('MIG-CF-'::text, 'case_file_display_seq'::regclass)")) @map("display_id")
  jobId     String   @unique @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job     Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  folders CaseFolder[]

  @@index([createdAt(sort: Desc)]) // case files list order
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "case_files_display_id_trgm_idx")
  @@map("case_files")
}

model CaseFolder {
  id            String   @id @default(uuid()) @db.Uuid
  displayId     String   @unique @default(dbgenerated("mig_next_display_id('MIG-FLD-'::text, 'case_folder_display_seq'::regclass)")) @map("display_id")
  caseFileId    String   @map("case_file_id") @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  caseFile    CaseFile    @relation(fields: [caseFileId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documents   Document[]

  @@index([caseFileId])
  @@index([caseFileId, createdAt]) // folders of a case file in order
  @@map("case_folders")
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  type        DocumentType
  status      DocumentStatus @default(PENDING)
  fileName    String         @map("file_name")
  mimeType    String         @map("mime_type")
  sizeBytes   Int            @map("size_bytes")
  storagePath String         @unique @map("storage_path")

  // Null only while PENDING for a candidate that does not exist yet (recruiter creating a profile).
  candidateId   String? @map("candidate_id") @db.Uuid
  // Set for documents submitted with an application (application copies are immutable).
  applicationId String? @map("application_id") @db.Uuid
  folderId      String? @map("folder_id") @db.Uuid
  uploadedById  String? @map("uploaded_by_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)

  candidate          CandidateProfile? @relation("CandidateDocuments", fields: [candidateId], references: [id], onDelete: Cascade)
  application        Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  folder             CaseFolder?       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedBy         User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  defaultResumeOwner CandidateProfile? @relation("DefaultResume")

  @@index([candidateId, status])
  @@index([folderId])
  @@index([applicationId])
  @@index([status, createdAt])
  @@map("documents")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  // Null when the change was made by the candidate (initial portal submission).
  changedById   String?            @map("changed_by_id") @db.Uuid
  note          String?
  changedAt     DateTime           @default(now()) @map("changed_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, changedAt])
  @@map("application_status_history")
}

model ApplicationNote {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  authorId      String?  @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

// Fixed-window counters for rate limiting (no Redis needed).
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("rate_limits")
}
